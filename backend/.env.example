# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/deriv_analysis_tool

# Deriv API
# DERIV_APP_ID: register a "Native app" (PAT type) at developers.deriv.com/dashboard —
# the old shared numeric app_id (1089) is no longer accepted by the API.
DERIV_APP_ID=your_registered_app_id_here
# DERIV_API_TOKEN: generate at app.deriv.com/account/api-token (Read + Trade + Trading information scopes)
DERIV_API_TOKEN=your_deriv_api_token_here
DERIV_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public
DERIV_ACCOUNT_TYPE=real
DERIV_CLIENT_EMAIL=client@example.com

# Auth
JWT_SECRET=change_this_to_a_long_random_string
TOKEN_ENCRYPTION_KEY=change_this_to_a_32_byte_random_string

# CORS
CLIENT_ORIGIN=http://localhost:5173
